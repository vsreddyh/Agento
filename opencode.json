{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/chat.md"],
  "mcp": {
    "servers": {
      "cookbook": {
        "type": "local",
        "command": ["./bin/cookbook"],
        "environment": {
          "MONGODB_URI": "{env:MONGODB_URI}",
          "MONGODB_DB": "{env:MONGODB_DB}"
        }
      },
      "health-check": {
        "type": "local",
        "command": ["./bin/health-check"],
        "environment": {
          "MONGODB_URI": "{env:MONGODB_URI}",
          "MONGODB_DB": "{env:MONGODB_DB}"
        }
      },
      "miser-money": {
        "type": "local",
        "command": ["./bin/miser-money"],
        "environment": {
          "MONGODB_URI": "{env:MONGODB_URI}",
          "MONGODB_DB": "{env:MONGODB_DB}"
        }
      },
      "project-manager": {
        "type": "local",
        "command": ["./bin/project-manager"],
        "environment": {
          "MONGODB_URI": "{env:MONGODB_URI}",
          "MONGODB_DB": "{env:MONGODB_DB}"
        }
      },
      "reports": {
        "type": "local",
        "command": ["./bin/reports"],
        "environment": {
          "MONGODB_URI": "{env:MONGODB_URI}",
          "MONGODB_DB": "{env:MONGODB_DB}"
        }
      },
      "task-manager": {
        "type": "local",
        "command": ["./bin/task-manager"],
        "environment": {
          "MONGODB_URI": "{env:MONGODB_URI}",
          "MONGODB_DB": "{env:MONGODB_DB}"
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "*delete*": "ask",
    "*archive_account*": "ask",
    "*create_account*": "ask",
    "*fix_last*": "ask",
    "*prune_old*": "ask",
    "*log_transaction*": "ask",
    "*log_text*": "ask",
    "*browser_goto*": "ask"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/chat.md"],
  "mcp": {
    "servers": {
      "cookbook": {
        "type": "local",
        "command": ["./scripts/mcp-run.sh", "cookbook"]
      },
      "health-check": {
        "type": "local",
        "command": ["./scripts/mcp-run.sh", "health-check"]
      },
      "miser-money": {
        "type": "local",
        "command": ["./scripts/mcp-run.sh", "miser-money"]
      },
      "project-manager": {
        "type": "local",
        "command": ["./scripts/mcp-run.sh", "project-manager"]
      },
      "reports": {
        "type": "local",
        "command": ["./scripts/mcp-run.sh", "reports"]
      },
      "task-manager": {
        "type": "local",
        "command": ["./scripts/mcp-run.sh", "task-manager"]
      },
      "workspace-mcp": {
        "type": "local",
        "command": ["./scripts/workspace-mcp.sh"]
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "*delete*": "ask",
    "*archive_account*": "ask",
    "*create_account*": "ask",
    "*fix_last*": "ask",
    "*prune_old*": "ask",
    "*log_transaction*": "ask",
    "*log_text*": "ask"
  }
}

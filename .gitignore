# ────────────────────────────────────────────────────────
# Environment — track .env.example, NEVER commit .env
# ────────────────────────────────────────────────────────
.env
!.env.example

# ────────────────────────────────────────────────────────
# Containers
# ────────────────────────────────────────────────────────
docker/.env
!docker/.env.example

# ────────────────────────────────────────────────────────
# Runtime (PIDs, logs, venvs for native zen-proxy / health-api / bots)
# ────────────────────────────────────────────────────────
run/

# ────────────────────────────────────────────────────────
# Workspace (per-bot cwd, host-only)
# ────────────────────────────────────────────────────────
workspace/

# ────────────────────────────────────────────────────────
# Gateway home (= god profile) + nested side profiles. There are NO
# per-profile .env files — the single root .env is the only source
# (AGENTS.md); this rule is a backstop, never commit if one appears.
# ────────────────────────────────────────────────────────
gateway/**/.env
!gateway/.env.example

# Rendered config (hermes reads config.yaml; the committed source is
# config.yaml.template) — never commit
gateway/**/config.yaml
gateway/**/config.rendered.yaml

# Per-profile runtime state (written by the gateways) — never commit
gateway/**/.cache/
gateway/**/.local/
gateway/**/.skills_prompt_snapshot.json
gateway/**/auth.lock
gateway/**/audio_cache/
gateway/**/bin/
gateway/**/cache/
gateway/**/channel_directory.json
gateway/**/cron/
gateway/**/gateway*
gateway/**/hooks/
gateway/**/image_cache/
gateway/**/kanban/
gateway/**/kanban.db*
gateway/**/logs/
gateway/**/pairing/
gateway/**/platforms/
gateway/**/sessions/
gateway/**/state/
gateway/**/state.db*
gateway/**/response_store.db*
gateway/**/sandboxes/
gateway/**/data/
gateway/**/.clean_shutdown
gateway/**/.update_check
gateway/**/models_dev_cache.json
gateway/**/ollama_cloud_models_cache.json
gateway/**/projects.db
gateway/**/node/
gateway/**/*.lock
gateway/**/.curator_backups/
gateway/**/auth.json
gateway/**/auth.json.backup
gateway/**/provider_models_cache.json
gateway/**/backups/
gateway/.npm/
gateway/runs_idempotency.db*
gateway/**/plugins/
gateway/**/skills/.hub/
# Per-profile skill copies are generated from the top-level skills/ on init
gateway/profiles/*/skills/podman-management/
gateway/profiles/*/skills/i-have-adhd/
# Live-gateway curator artifact at the home level — regenerated at runtime,
# never commit (side-profile .curator_state files ARE committed seed state).
gateway/skills/.curator_state
# Official-image runtime downloads/state at the home level.
gateway/install_id
gateway/lazy-packages/
gateway/models_dev_cache.etag
gateway/shared-state.db*
gateway/spawn-ledger.json
# Bundled-skill sync target (official stage2 syncs 58 packs here at boot).
# Our project skills live in top-level skills/ and are installed to
# gateway/skills/ + sides by init; the rest is upstream content — ignore all.
gateway/skills/*

# Hermes skill CONTENT (incl. autogenerated + nousresearch/ packs), the
# skill-curator learning state (.curator_state / .usage.json), long-term
# memories (profiles/*/memories/), and each SOUL.md are COMMITTED so the whole
# personality + learned state survives moving between VPSes. Only the transient
# per-run session/log state above is ignored.

# ────────────────────────────────────────────────────────
# Android app (agento)
# ────────────────────────────────────────────────────────
android/agento/.gradle/
android/agento/build/
android/agento/app/build/
android/agento/local.properties
android/agento/.kotlin/
*.apk

# ────────────────────────────────────────────────────────
# OS / Editor
# ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.pyc
__pycache__/
# Go build outputs
/health-api
/mongo
/retention
/miser-money
/cookbook
/health-check

# ────────────────────────────────────────────────────────
# Environment — track .env.example, NEVER commit .env
# ────────────────────────────────────────────────────────
.env
!.env.example

# ────────────────────────────────────────────────────────
# Containers
# ────────────────────────────────────────────────────────
docker/.env
!docker/.env.example

# ────────────────────────────────────────────────────────
# Runtime (PIDs, logs, venvs for native zen-proxy / health-api / bots)
# ────────────────────────────────────────────────────────
run/

# ────────────────────────────────────────────────────────
# Workspace (per-bot cwd, host-only)
# ────────────────────────────────────────────────────────
workspace/

# ────────────────────────────────────────────────────────
# Bot profiles — secrets live in per-profile .env, never commit
# `**` so rules also cover named profiles nested under the default
# profile home (profiles/master/profiles/<name>/ in the multiplex layout).
# ────────────────────────────────────────────────────────
profiles/**/.env
!profiles/*/.env.example
!profiles/**/.env.example

# Rendered config (hermes reads config.yaml; the committed source is
# config.yaml.template) — never commit
profiles/**/config.yaml
profiles/**/config.rendered.yaml

# Per-profile runtime state (written by the gateways) — never commit
profiles/**/.cache/
profiles/**/.local/
profiles/**/.skills_prompt_snapshot.json
profiles/**/auth.lock
profiles/**/audio_cache/
profiles/**/bin/
profiles/**/cache/
profiles/**/channel_directory.json
profiles/**/cron/
profiles/**/gateway*
profiles/**/hooks/
profiles/**/image_cache/
profiles/**/kanban/
profiles/**/kanban.db*
profiles/**/logs/
profiles/**/pairing/
profiles/**/platforms/
profiles/**/sessions/
profiles/**/state/
profiles/**/state.db*
profiles/**/sandboxes/
profiles/**/data/
profiles/**/.clean_shutdown
profiles/**/.update_check
profiles/**/models_dev_cache.json
profiles/**/ollama_cloud_models_cache.json
profiles/**/projects.db
profiles/**/node/
profiles/**/*.lock
profiles/**/.curator_backups/
profiles/**/auth.json
profiles/**/auth.json.backup
profiles/**/provider_models_cache.json
profiles/**/plugins/
profiles/**/skills/.hub/
# Per-profile skill copies are generated from the top-level skills/ on init
profiles/*/profiles/*/skills/podman-management/
profiles/*/profiles/*/skills/i-have-adhd/

# Hermes skill CONTENT (incl. autogenerated + nousresearch/ packs), the
# skill-curator learning state (.curator_state / .usage.json), long-term
# memories (profiles/*/memories/), and each SOUL.md are COMMITTED so the whole
# personality + learned state survives moving between VPSes. Only the transient
# per-run session/log state above is ignored.

# ────────────────────────────────────────────────────────
# Android app (agento)
# ────────────────────────────────────────────────────────
android/agento/.gradle/
android/agento/build/
android/agento/app/build/
android/agento/local.properties
android/agento/.kotlin/
*.apk

# ────────────────────────────────────────────────────────
# OS / Editor
# ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.pyc
__pycache__/

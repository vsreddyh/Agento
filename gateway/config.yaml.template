model:
  default: mimo-v2.6-flash
  provider: opencode-go
  base_url: ${HERMES_BASE_URL}
  api_key: "${OPENCODE_API_KEY}"

# God = the gateway home = Hermes' built-in "default" profile.
# Story + resumes are side profiles nested under HERMES_HOME/profiles/.
# There is no profiles/default/ dir: Hermes maps the name "default" to the
# home dir itself and skips any nested dir of that name.
gateway:
  multiplex_profiles: true

# Built-in OpenAI-compatible HTTP API for the custom Android app
# (3 chat tabs + Settings). NOTE: hermes-agent only reads this from the
# `platforms:` map (extra.host/port/key) — a `gateway.api_server` block is
# silently ignored. The primary profile owns the sole listener; multiplexed
# profiles are served through the /p/<profile>/ URL prefix.
# Key is rendered from PASSWORD in the root .env (doubles as the single
# app password; the Android app sends it as the bearer credential).
platforms:
  api_server:
    enabled: true
    extra:
      host: 0.0.0.0
      port: 8642
      key: "${PASSWORD}"

auxiliary:
  vision:
    model: mimo-v2.6-flash

agent:
  max_turns: 90
  reasoning_effort: medium
  disabled_toolsets:
    - feishu_doc
    - feishu_drive
    - homeassistant
    - spotify
    - x_search
    - yuanbao

terminal:
  backend: local
  cwd: ${HERMES_CWD}
  timeout: 180

approvals:
  mode: smart

browser:
  inactivity_timeout: 120

session_reset:
  mode: idle
  idle_minutes: 1440
  at_hour: 4

curator:
  enabled: true
  interval_hours: 24
  stale_after_days: 30
  archive_after_days: 45
  consolidate: false

stt:
  enabled: true
  provider: local
  local:
    model: base

updates:
  pre_update_backup: false
  backup_keep: 3
  non_interactive_local_changes: stash

compression:
  enabled: true
  threshold: 0.5
  target_ratio: 0.2
  protect_last_n: 20
  protect_first_n: 3

display:
  compact: false
  skin: default
  streaming: true
  show_reasoning: false
  tool_progress: all

memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375

delegation:
  max_iterations: 50

skills:
  creation_nudge_interval: 15

security:
  redact_secrets: true

code_execution:
  timeout: 300
  max_tool_calls: 50

hooks_auto_accept: true

hooks: {}

goals:
  max_turns: 20

tts:
  provider: edge
  edge:
    voice: en-US-AriaNeural

streaming:
  enabled: false

prompt_caching:
  cache_ttl: 5m

onboarding:
  seen:
    profile_build_offered: true
  profile_build: off

group_sessions_per_user: false

platform_toolsets:
  cli:
    - file
    - terminal

# God tool backend: money + cookbook + health-check (in-repo Go MCP servers,
# baked into the bot image at /usr/local/bin by test/Dockerfile).
mcp_servers:
  miser-money:
    command: "/usr/local/bin/miser-money"
    args: []
    env:
      MONGODB_URI: "${MONGODB_URI}"
      MONGODB_DB: "${MONGODB_DB}"
    timeout: 120
    connect_timeout: 60
  cookbook:
    command: "/usr/local/bin/cookbook"
    args: []
    env:
      MONGODB_URI: "${MONGODB_URI}"
      MONGODB_DB: "${MONGODB_DB}"
    timeout: 120
    connect_timeout: 60
  health-check:
    command: "/usr/local/bin/health-check"
    args: []
    env:
      MONGODB_URI: "${MONGODB_URI}"
      MONGODB_DB: "${MONGODB_DB}"
    timeout: 120
    connect_timeout: 60
  # Browser automation (Playwright MCP, headless chromium bundled in the bot
  # image). Same stdio server on every bot profile.
  playwright:
    command: "npx"
    args: ["-y", "@playwright/mcp@latest", "--browser", "chromium", "--headless"]
    timeout: 120
    connect_timeout: 60

_config_version: 33

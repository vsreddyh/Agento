model:
  default: mimo-v2.6-flash
  provider: opencode-go
  base_url: ${HERMES_BASE_URL}
  api_key: ${OPENCODE_API_KEY}

agent:
  max_turns: 90
  reasoning_effort: medium
  disabled_toolsets:
    - feishu_doc
    - feishu_drive
    - homeassistant
    - image_gen
    - session_search
    - spotify
    - video
    - video_gen
    - vision
    - web
    - x_search
    - yuanbao

terminal:
  backend: local
  cwd: ${HERMES_CWD}
  timeout: 180

approvals:
  mode: smart

session_reset:
  mode: none

memory:
  memory_enabled: true

group_sessions_per_user: false

platform_toolsets:
  cli:
    - file
    - terminal

# Browser automation (Playwright MCP, headless chromium bundled in the bot
# image). Same stdio server on every bot profile.
mcp_servers:
  playwright:
    command: "npx"
    args: ["-y", "@playwright/mcp@latest", "--browser", "chromium", "--headless"]
    timeout: 120
    connect_timeout: 60

_config_version: 34

onboarding:
  seen:
    profile_build_offered: true
  profile_build: off

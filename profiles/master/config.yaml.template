model:
  default: muse-spark-1.2-contributor-free
  provider: opencode
  base_url: ${HERMES_BASE_URL}
  api_key: ${OPENCODE_ZEN_API_KEY}

# Gateway home: multiplex host for the named profiles under
# HERMES_HOME/profiles/ (story, resumes, default-god). This profile is NOT
# a bot itself — it only hosts the multiplexed gateway.
gateway:
  multiplex_profiles: true
  # Built-in OpenAI-compatible HTTP API for the custom Android app
  # (3 chat tabs + Settings). One port; each tab sends its profile's
  # model name (see GET /v1/models to confirm names under multiplex).
  # Key is required — rendered from HEALTH_SYNC_TOKEN in the root .env.
  # The sync token doubles as the single app password (chat + sync share
  # it; the Android app sends it as the bearer credential on every call).
  api_server:
    enabled: true
    host: 0.0.0.0
    port: 8642
    key: ${HEALTH_SYNC_TOKEN}

auxiliary:
  vision:
    model: muse-spark-1.2-contributor-free

agent:
  max_turns: 90
  reasoning_effort: medium
  disabled_toolsets:
    - feishu_doc
    - feishu_drive
    - homeassistant
    - spotify
    - x_search
    - yuanbao

terminal:
  backend: local
  cwd: ${HERMES_CWD}
  timeout: 180

approvals:
  mode: smart

browser:
  inactivity_timeout: 120

web:
  search_backend: searxng

session_reset:
  mode: idle
  idle_minutes: 1440
  at_hour: 4

curator:
  enabled: true
  interval_hours: 24
  stale_after_days: 30
  archive_after_days: 45
  consolidate: false

stt:
  enabled: true
  provider: local
  local:
    model: base

updates:
  pre_update_backup: false
  backup_keep: 3
  non_interactive_local_changes: stash

compression:
  enabled: true
  threshold: 0.5
  target_ratio: 0.2
  protect_last_n: 20
  protect_first_n: 3

display:
  compact: false
  skin: default
  streaming: true
  show_reasoning: false
  tool_progress: all

memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375

delegation:
  max_iterations: 50

skills:
  creation_nudge_interval: 15

security:
  redact_secrets: true

code_execution:
  timeout: 300
  max_tool_calls: 50

hooks_auto_accept: true

hooks: {}

goals:
  max_turns: 20

tts:
  provider: edge
  edge:
    voice: en-US-AriaNeural

streaming:
  enabled: false

prompt_caching:
  cache_ttl: 5m

onboarding:
  seen:
    profile_build_offered: true
  profile_build: off

group_sessions_per_user: false

platform_toolsets:
  cli:
    - file
    - terminal

_config_version: 33

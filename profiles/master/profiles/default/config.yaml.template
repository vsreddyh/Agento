model:
  default: glm-5.1
  provider: opencode-go
  base_url: ${HERMES_BASE_URL}
  api_key: ${OPENCODE_API_KEY}

agent:
  max_turns: 90
  reasoning_effort: medium
  disabled_toolsets:
    - feishu_doc
    - feishu_drive
    - homeassistant
    - image_gen
    - session_search
    - spotify
    - video
    - video_gen
    - vision
    - web
    - x_search
    - yuanbao

terminal:
  backend: local
  cwd: ${HERMES_CWD}
  timeout: 180

approvals:
  mode: smart

session_reset:
  mode: none

memory:
  memory_enabled: true

group_sessions_per_user: false

platform_toolsets:
  cli:
    - file
    - terminal

# God profile tool backend: money + cookbook + health-check (in-repo mcps/*)
# run as stdio MCP servers. Mounts (compose): ../mcps/money:/mcps/miser-money:ro,
# ../mcps/common:/mcps/common:ro, ../mcps/cookbook:/mcps/cookbook:ro,
# ../mcps/health_check:/mcps/health_check:ro.
mcp_servers:
  miser-money:
    command: "python3"
    args: ["/mcps/miser-money/server.py"]
    env:
      MONGODB_URI: "${MONGODB_URI}"
      MONGODB_DB: "${MONGODB_DB}"
    timeout: 120
    connect_timeout: 60
  cookbook:
    command: "python3"
    args: ["/mcps/cookbook/server.py"]
    env:
      MONGODB_URI: "${MONGODB_URI}"
      MONGODB_DB: "${MONGODB_DB}"
      PYTHONPATH: "/mcps"
    timeout: 120
    connect_timeout: 60
  health-check:
    command: "python3"
    args: ["/mcps/health_check/server.py"]
    env:
      MONGODB_URI: "${MONGODB_URI}"
      MONGODB_DB: "${MONGODB_DB}"
      PYTHONPATH: "/mcps"
    timeout: 120
    connect_timeout: 60
  # Browser automation (Playwright MCP, headless chromium bundled in the bot
  # image). Same stdio server on every bot profile.
  playwright:
    command: "npx"
    args: ["-y", "@playwright/mcp@latest", "--browser", "chromium", "--headless"]
    timeout: 120
    connect_timeout: 60

_config_version: 35

onboarding:
  seen:
    profile_build_offered: true
  profile_build: off

# ─────────────────────────────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH — every env var for the whole stack lives in
# this one file. Copy it to `.env` and fill in real values. There are
# NO per-profile `.env` files; compose maps these vars
# into each service as needed.
# ─────────────────────────────────────────────────────────────────────

# ── LLM Provider API Key (VPS-ONLY secret — never committed) ──────
# Real key lives ONLY in the git-ignored root `.env` on the VPS.
# Provider + model are picked per request in the Android app Settings
# (opencode | opencode-go) — one key covers both. This file carries placeholders only.
OPENCODE_API_KEY=sk-...            # OpenCode (direct, no proxy) — also used as HERMES_API_KEY via compose

# ── Android app password (single credential for chat + sync) ──────
# PASSWORD doubles as the app password: the gateway
# chat API and health-api both accept it as the bearer credential, and the
# Android app sends it on every call (one Password field, no separate keys).
# Must match the Password field in Agento Settings.
# Generate with: openssl rand -hex 32
PASSWORD=change-me

# ── Single app URL (reverse proxy: chat + sync on one port) ─────────
# The proxy routes /p/* → gateway :8642 (chat) and /api/* + /health →
# health-api :8000 (sync). Point the Agento app's Server URL here:
# http://<host>:8080 — one URL for chat AND sync. Direct ports
# (:8642, :8001) stay published for backward compatibility.
# APP_PORT=8080                   # override (compose default: 8080)
# API_SERVER_PORT=8642            # override (compose default: 8642)

# ── Remote MongoDB (Atlas: money/health/cookbook domain data) ───────
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/
MONGODB_DB=hermes

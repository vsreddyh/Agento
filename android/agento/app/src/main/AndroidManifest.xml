<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect requires runtime permission; declared at manifest level for 13+ check. -->
    <uses-permission android:name="android.permission.HEALTH_PERMISSION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Due-time task reminders: exact alarms when the OS grants them
         (inexact fallback otherwise). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Fired when a reminder or update check needs attention while the app
         is backgrounded (Settings → Notifications, issue #58). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updater (Settings → App updates): fires the platform package
         installer for a downloaded release APK (issue #6). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Health Connect data permissions. REQUIRED for API 34+ (Android 14+):
         without these, the OS silently revokes access and the app never
         appears in Health Connect's app list. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".AgentoApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Agento"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- adjustResize: the keyboard shrinks the layout instead of panning
             the whole window, so the top bar stays pinned and only the
             message list compresses. -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission rationale → takes user to Health Connect's
             own permission screen for the requested record types.
             BOTH intent-filters are required (Android ≤13 uses
             ACTION_SHOW_PERMISSIONS_RATIONALE, Android 14+ uses
             VIEW_PERMISSION_USAGE). Missing either = silent permission
             revocation, app never listed in Health Connect. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serves downloaded release APKs to the platform installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager runs setForeground() via its internal
             SystemForegroundService. Android 14+ (targetSdk 34+) requires an
             explicit FGS type or the app crashes on launch with
             InvalidForegroundServiceTypeException. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".TaskWidget"
            android:exported="false"
            android:label="@string/task_widget_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- Collection adapter backing the task widget's scrollable list. -->
        <service
            android:name=".TaskWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Invisible trampoline for task-widget row taps: completes the
             task or forwards to MainActivity, then finishes. Exported so
             the widget host can send its PendingIntent. -->
        <activity
            android:name=".TaskCompleteActivity"
            android:theme="@style/Theme.Agento.Trampoline"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true" />

        <!-- Per-widget display settings (density, due line): launched by
             the system at add time via android:configure and later by
             tapping the widget's title. -->
        <activity
            android:name=".TaskWidgetConfigActivity"
            android:theme="@style/Theme.Agento"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Due-time task reminder alarms (explicit intents only). -->
        <receiver
            android:name=".TaskAlarmReceiver"
            android:exported="false" />

        <!-- Reminder notification [Completed]/[Skip] actions (#368):
             explicit intents only, so non-exported like the receiver above.
             The widget rows keep the activity trampolines for
             background-launch reasons; notification actions need none. -->
        <receiver
            android:name=".TaskNotifActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

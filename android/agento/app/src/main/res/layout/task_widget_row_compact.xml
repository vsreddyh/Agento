<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget row: tighter padding, smaller text, name only (the due
     line is controlled separately by the per-widget display setting). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/task_widget_row_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="6dp"
        android:src="@drawable/task_check"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_widget_complete" />

    <TextView
        android:id="@+id/task_widget_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/task_widget_row_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Style B (diagnostic, #137): header text only — the two TextViews we
     already use, concrete colors, no background drawable, no buttons, no
     click intents, no collection. Isolates text/theme from chrome. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/task_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_widget_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/task_widget_text_primary" />

    <TextView
        android:id="@+id/task_widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:text="@string/task_widget_loading"
        android:textColor="@color/task_widget_text_secondary" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One scrollable row in the task widget list: name takes the width,
     due label hugs the right and ellipsizes independently. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/task_widget_row_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:src="@drawable/task_check"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_widget_complete" />

    <TextView
        android:id="@+id/task_widget_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/task_widget_text_primary" />

    <TextView
        android:id="@+id/task_widget_row_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:textColor="@color/task_widget_text_secondary" />

</LinearLayout>

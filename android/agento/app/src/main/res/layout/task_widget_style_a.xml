<?xml version="1.0" encoding="utf-8"?>
<!-- Style A (diagnostic, #137): the most basic RemoteViews a widget can be.
     One plain TextView — no background, no theme attrs, no click targets,
     no collection. If THIS fails to render, the problem is not our
     layout/rows/collection but something package- or provider-level. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <TextView
        android:id="@+id/task_widget_probe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/task_widget_title"
        android:textSize="14sp" />

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Task manager widget (#101): RemoteViews can't use Compose, so this is a
     plain LinearLayout — count + first open task, tap opens Task Manager. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task Manager"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/task_widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_widget_loading" />

    <TextView
        android:id="@+id/task_widget_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end" />

    <ImageButton
        android:id="@+id/task_widget_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_rotate"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_widget_refresh" />

</LinearLayout>

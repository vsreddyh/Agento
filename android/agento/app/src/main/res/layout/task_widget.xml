<?xml version="1.0" encoding="utf-8"?>
<!-- Task manager widget (#101): card with header (title + count + refresh),
     divider, then a scrollable ListView fed by TaskWidgetService. The list
     takes all remaining height (weight 1), so any placement at/above the
     3x2 minimum fills instead of leaving a blank slab; all 30 tasks are
     reachable by scroll, no "+N more" truncation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/task_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_widget_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/task_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="@string/task_widget_loading"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/task_widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_widget_refresh" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/task_widget_divider" />

    <ListView
        android:id="@+id/task_widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/task_widget_divider"
        android:dividerHeight="1dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/task_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:text="@string/task_widget_loading"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Task widget with ALL chrome, used by the D1→D5 diagnostic steps
     (issue #137). Style C (task_widget_style_c.xml) proved the header
     structure renders; each D step turns on exactly one more element of
     this layout, so the first D that fails names the culprit:
       D1 rows · D2 +divider · D3 +empty text · D4 +header toggle
       D5 +title→settings tap
     Elements below the header start GONE so a step that doesn't use them
     never touches them. Keep the header identical to style C. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/task_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_widget_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/task_widget_text_primary" />

            <TextView
                android:id="@+id/task_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="@string/task_widget_loading"
                android:textColor="@color/task_widget_text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/task_widget_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/task_widget_text_secondary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/task_widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@android:color/transparent"
            android:contentDescription="@string/task_widget_refresh" />

    </LinearLayout>

    <View
        android:id="@+id/task_widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/task_widget_divider"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/task_widget_static_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/task_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/task_widget_text_secondary"
        android:visibility="gone" />

</LinearLayout>

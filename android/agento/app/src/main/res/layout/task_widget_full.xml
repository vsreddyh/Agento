<?xml version="1.0" encoding="utf-8"?>
<!-- Task widget, plain-rows mode (no scrollable list). Structure is the one
     the #137 bisect proved renders on the affected launcher: header text +
     refresh, then the task rows, the empty-state line, and the view toggle.
     Deliberately NO 1dp divider View — that single element made the
     launcher reject the whole RemoteViews. The scrolling variant is
     task_widget_list.xml, same chrome with a ListView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/task_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_widget_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/task_widget_text_primary" />

            <TextView
                android:id="@+id/task_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="@string/task_widget_loading"
                android:textColor="@color/task_widget_text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/task_widget_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/task_widget_text_secondary" />

        <ImageButton
            android:id="@+id/task_widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@android:color/transparent"
            android:contentDescription="@string/task_widget_refresh" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/task_widget_static_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/task_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/task_widget_text_secondary" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostic step D1 (issue #137). Header is byte-identical to
     task_widget_style_c.xml; the only difference from the previous step is
     the element below, so the first failing step names the culprit. The 1dp
     divider View that used to sit here is removed for good — it alone made
     this launcher reject the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/task_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_widget_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/task_widget_text_primary" />

            <TextView
                android:id="@+id/task_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="@string/task_widget_loading"
                android:textColor="@color/task_widget_text_secondary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/task_widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@android:color/transparent"
            android:contentDescription="@string/task_widget_refresh" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/task_widget_static_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>

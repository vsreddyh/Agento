    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/task_widget_ring"
        android:pathData="M6,6 L13.5,12 L6,18 Z" />
    <path
        android:fillColor="@color/task_widget_ring"
        android:pathData="M12.5,6 L20,12 L12.5,18 Z" />
</vector>

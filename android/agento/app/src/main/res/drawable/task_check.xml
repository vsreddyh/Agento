<?xml version="1.0" encoding="utf-8"?>
<!-- Hollow ring used as the widget row's complete button. Concrete color
     (not a theme attr): theme references inside widget drawables fail to
     resolve on some launchers (issue #137). Night variant in values-night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="2dp"
        android:color="@color/task_widget_ring" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>

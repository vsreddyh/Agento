<?xml version="1.0" encoding="utf-8"?>
<!-- Hollow ring used as the widget row's complete button; stroke follows
     the secondary text color so it stays visible in light and dark mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="2dp"
        android:color="?android:attr/textColorSecondary" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>
